import 'package:flutter/material.dart';

class TunnelScreen extends StatefulWidget {
  const TunnelScreen({super.key});

  @override
  State<TunnelScreen> createState() => _TunnelScreenState();
}

class _TunnelScreenState extends State<TunnelScreen> {
  String gpsStatus = "Connected";
  String navigationMode = "NavIC/GPS";
  Color statusColor = Colors.green;
  Color modeColor = Colors.blue;

  void enterTunnel() {
    setState(() {
      gpsStatus = "Lost";
      navigationMode = "AI Dead Reckoning";
      statusColor = Colors.red;
      modeColor = Colors.purple;
    });
  }

  void exitTunnel() {
    setState(() {
      gpsStatus = "Connected";
      navigationMode = "NavIC/GPS";
      statusColor = Colors.green;
      modeColor = Colors.blue;
    });
  }

  void resetSimulation() {
    setState(() {
      gpsStatus = "Connected";
      navigationMode = "NavIC/GPS";
      statusColor = Colors.green;
      modeColor = Colors.blue;
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF0A192F),

      appBar: AppBar(
        backgroundColor: const Color(0xFF112240),
        centerTitle: true,
        title: const Text(
          "Tunnel Simulation",
          style: TextStyle(
            fontWeight: FontWeight.bold,
            color: Colors.white,
          ),
        ),
      ),

      body: Padding(
        padding: const EdgeInsets.all(20),

        child: Column(
          crossAxisAlignment: CrossAxisAlignment.center,
          children: [

            const SizedBox(height: 20),

            const Icon(
              Icons.navigation,
              size: 90,
              color: Colors.blue,
            ),

            const SizedBox(height: 20),

            const Text(
              "NavIC Based Intelligent Navigation",
              textAlign: TextAlign.center,
              style: TextStyle(
                color: Colors.white,
                fontSize: 22,
                fontWeight: FontWeight.bold,
              ),
            ),

            const SizedBox(height: 40),

            Card(
              color: const Color(0xFF112240),

              child: Padding(
                padding: const EdgeInsets.all(20),

                child: Column(
                  children: [

                    const Text(
                      "GPS Status",
                      style: TextStyle(
                        color: Colors.white70,
                        fontSize: 18,
                      ),
                    ),

                    const SizedBox(height: 10),

                    Text(
                      gpsStatus,
                      style: TextStyle(
                        color: statusColor,
                        fontSize: 28,
                        fontWeight: FontWeight.bold,
                      ),
                    ),

                    const SizedBox(height: 25),

                    const Text(
                      "Navigation Mode",
                      style: TextStyle(
                        color: Colors.white70,
                        fontSize: 18,
                      ),
                    ),

                    const SizedBox(height: 10),

                    Text(
                      navigationMode,
                      textAlign: TextAlign.center,
                      style: TextStyle(
                        color: modeColor,
                        fontSize: 24,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ],
                ),
              ),
            ),

            const SizedBox(height: 40),

            SizedBox(
              width: double.infinity,
              child: ElevatedButton(
                onPressed: enterTunnel,
                style: ElevatedButton.styleFrom(
                  backgroundColor: Colors.red,
                  padding: const EdgeInsets.all(15),
                ),
                child: const Text(
                  "Enter Tunnel",
                  style: TextStyle(fontSize: 18),
                ),
              ),
            ),

            const SizedBox(height: 15),

            SizedBox(
              width: double.infinity,
              child: ElevatedButton(
                onPressed: exitTunnel,
                style: ElevatedButton.styleFrom(
                  backgroundColor: Colors.green,
                  padding: const EdgeInsets.all(15),
                ),
                child: const Text(
                  "Exit Tunnel",
                  style: TextStyle(fontSize: 18),
                ),
              ),
            ),

            const SizedBox(height: 15),

            SizedBox(
              width: double.infinity,
              child: ElevatedButton(
                onPressed: resetSimulation,
                style: ElevatedButton.styleFrom(
                  backgroundColor: Colors.blue,
                  padding: const EdgeInsets.all(15),
                ),
                child: const Text(
                  "Reset",
                  style: TextStyle(fontSize: 18),
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}